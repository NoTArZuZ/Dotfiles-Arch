*background: #141415
*foreground: #cdcdcd

! Black + DarkGrey
*color0:  #252530
*color8:  #606079

! DarkRed + Red
*color1:  #d8647e
*color9:  #e08398

! DarkGreen + Green
*color2:  #7fa563
*color10: #99b782

! DarkYellow + Yellow
*color3:  #f3be7c
*color11: #f5cb96

! DarkBlue + Blue
*color4:  #6e94b2
*color12: #8ba9c1

! DarkMagenta + Magenta
*color5:  #bb9dbd
*color13: #c9b1ca

! DarkCyan + Cyan
*color6:  #aeaed1
*color14: #bebeda

! LightGrey + White
*color7:  #cdcdcd
*color15: #d7d7d7

