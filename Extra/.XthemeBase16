*background: #1d1f21
*foreground: #c5c8c6

! Black + DarkGrey
*color0:  #0f0f0f
*color8:  #969896

! DarkRed + Red
*color1:  #cc342b
*color9:  #cc342b

! DarkGreen + Green
*color2:  #198844
*color10: #198844

! DarkYellow + Yellow
*color3:  #fba922
*color11: #fba922

! DarkBlue + Blue
*color4:  #3971ed
*color12: #3971ed

! DarkMagenta + Magenta
*color5:  #a36ac7
*color13: #a36ac7

! DarkCyan + Cyan
*color6:  #3971ed
*color14: #3971ed

! LightGrey + White
*color7:  #c5c8c6
*color15: #ffffff

