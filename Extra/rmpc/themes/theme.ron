#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: false,
    draw_borders: false,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: None,
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "yellow"),
    preview_metadata_group_style: (fg: "yellow", modifiers: "Bold"),
    tab_bar: (
        enabled: true,
        active_style: (fg: "black", bg: "yellow", modifiers: "Bold"),
        inactive_style: (),
    ),
    highlighted_item_style: (fg: "yellow", modifiers: "Bold"),
    current_item_style: (fg: "black", bg: "white", modifiers: "Bold"),
    borders_style: (fg: "yellow"),
    highlight_border_style: (fg: "yellow"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "white"),
        warn: (fg: "yellow"),
        error: (fg: "red"),
        debug: (fg: "light_green"),
        trace: (fg: "magenta"),
    ),
    progress_bar: (
        symbols: ["", "", ""],
        track_style: (fg: "dark_gray"),
        elapsed_style: (fg: "green"),
        thumb_style: (fg: "green"),
    ),
    scrollbar: None, // (
    //     symbols: ["│", "█", "▲", "▼"],
    //     track_style: (),
    //     ends_style: (),
    //     thumb_style: (fg: "white"),
    // ),
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            width: "65%",
            alignment: Center,
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    components: {},
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Tabs),
                size: "1",
            ),
            (
                size: "5",
                borders: "ALL",
                pane: Split(
                    direction: Vertical,
                    panes: [
                        (pane: Pane(Header), size: "2"),
                        (pane: Pane(ProgressBar), size: "1"),
                    ],
                ),
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (kind: Text("["), style: (fg: "yellow", modifiers: "Bold")),
                    (kind: Property(Status(StateV2(playing_label: "Playing", paused_label: "Paused", stopped_label: "Stopped"))), style: (fg: "yellow", modifiers: "Bold")),
                    (kind: Text("]"), style: (fg: "yellow", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Track)), style: (modifiers: "Bold"),
                        default: (kind: Text("00"), style: (modifiers: "Bold"))
                    ),
                    (kind: Text("  "), style: (fg: "green")),
                    (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (modifiers: "Bold"))
                    ),
                    (kind: Text(" "), style: (fg: "magenta"))
                ],
                right: [
                    (kind: Property(Widget(ScanStatus)), style: (fg: "white")),
                    (kind: Property(Widget(Volume)), style: (fg: "yellow"))
                ]
            ),
            (
                left: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "white", modifiers: "Bold"),
                            separator_style: (fg: "white")))
                        ),
                        style: (fg: "dark_gray")
                    ),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "red"),
                        default: (kind: Text("Unknown"), style: (fg: "red"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Album)), style: (fg: "green"),
                        default: (kind: Text("Unknown Album"), style: (fg: "green"))
                    ),
                    (kind: Text(" (")),
                    (kind: Property(Song(Other("date"))), style: (fg: "blue"),
                        default: (kind: Text("Unknown Year"), style: (fg: "blue"))
                    ),
                    (kind: Text(")")),
                ],
                right: [
                    (kind: Property(Status(Elapsed))),
                    (kind: Text(" / ")),
                    (kind: Property(Status(Duration))),
                    (kind: Text(" (")),
                    (kind: Property(Status(QueueTimeTotal(separator: " ")))),
                    (kind: Text(" Queue)"))
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Text("[")),
                (kind: Property(Duration)),
                (kind: Text("]")),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    lyrics: (
        timestamp: false
    )
)
