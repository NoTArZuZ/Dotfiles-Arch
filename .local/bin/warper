#!/usr/bin/env bash

set -eo pipefail

logo()
{
	command clear
	echo ' _      ______ __________  ___  _____'
	echo '| | /| / / __ `/ ___/ __ \/ _ \/ ___/'
	echo '| |/ |/ / /_/ / /  / /_/ /  __/ /    '
	echo '|__/|__/\__,_/_/  / .___/\___/_/     '
	echo '                 /_/                 '
	echo ''
}

menu()
{
	trap 'exit 0' INT
	logo
	warp-cli status
	echo ''
	echo '1. Connect'
	echo '2. Disconnect'
	echo '3. Register'
	echo '4. Change Mode'
	echo '5. Change Protocol'
	echo '6. Setup Endpoint'
	echo '7. Monitor Status'
	echo ''
	read -r -p "Select: (1-7) " option
	[ -z "$option" ] && exit 0
	trap 'option="" && menu && main' INT # Come back to menu on Ctrl-C
	return 0
}

modes()
{
	[ "$1" ] || logo
	echo '1. warp'
	echo '2. warp+doh'
	echo '3. warp+dot'
	echo ''
	read -r -p "Select: (1-3) " mode
	[ -z "$mode" ] && return 0
	[ "$mode" = "1" ] && warp-cli mode warp
	[ "$mode" = "2" ] && warp-cli mode warp+doh
	[ "$mode" = "3" ] && warp-cli mode warp+dot
	sleep 1
	return 0
}

protocols()
{
	[ "$1" ] || logo
	echo '1. MASQUE'
	echo '2. WireGuard'
	echo ''
	read -r -p "Select: (1-2) " protocol
	[ -z "$protocol" ] && return 0
	[ "$protocol" = "1" ] && warp-cli tunnel protocol set MASQUE
	[ "$protocol" = "2" ] && warp-cli tunnel protocol set WireGuard
	sleep 1
	return 0
}

endpoints()
{
	[ "$1" ] || logo
	read -r -p "IP and Port of the Endpoint: " endpoint
	[ -z "$endpoint" ] && warp-cli tunnel endpoint reset && return 0
	warp-cli tunnel endpoint set "$endpoint" || :
	sleep 1
	return 0
}

main()
{
	[ "$option" = "1" ] || [ "$option" = "connect" ] && {
		[ "$1" ] || logo
		warp-cli disconnect
		warp-cli connect
		sleep 1
		option="7"
	}
	[ "$option" = "2" ] || [ "$option" = "disconnect" ] && {
		[ "$1" ] || logo
		warp-cli disconnect
		sleep 1
		option=""
		[ "$1" ] || menu && main
	}
	[ "$option" = "3" ] || [ "$option" = "register" ] && {
		[ "$1" ] || logo
		warp-cli registration delete || :
		warp-cli registration new
		sleep 1
		option=""
		[ "$1" ] || menu && main
	}
	[ "$option" = "4" ] || [ "$option" = "mode" ] && {
		modes
		option=""
		[ "$1" ] || menu && main
	}
	[ "$option" = "5" ] || [ "$option" = "protocol" ] && {
		protocols
		option=""
		[ "$1" ] || menu && main
	}
	[ "$option" = "6" ] || [ "$option" = "endpoint" ] && {
		endpoints
		option=""
		[ "$1" ] || menu && main
	}
	[ "$option" = "7" ] || [ "$option" = "status" ] && {
		while true; do
			logo
			warp-cli status
			sleep 1
		done
	}
	return 0
}

option="$1"; [ "$1" ] || menu
main "$1"

exit 0
