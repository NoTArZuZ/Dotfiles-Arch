#!/usr/bin/env bash

getarg="$@"

encryptmsg() {
	read -r -p "Enter Recipient(s): " email; [ -z "$email" ] && exit 1
	tempfile="/tmp/tmpencmsg-$(date '+%N')"
	$EDITOR "$tempfile"; [ -s "$tempfile" ] || exit 1
	msg=$(cat "$tempfile")
	rm -f "$tempfile"
	encmsg=$(echo "$msg" | gpg --encrypt --armor -r $email)
	echo "$encmsg"
	read -r -p "Copy Message? [Y/n]: " tocopy
	[ "$tocopy" = "y" ] || [ "$tocopy" = "Y" ] || [ -z "$tocopy" ] && ( echo "$encmsg" | xclip -r -sel c )
}
encryptfile() {
	encfile="${getarg}.gpg"
	read -r -p "Enter recipient(s): " email; [ -z "$email" ] && exit 1
	gpg --encrypt --armor -r $email --output "$encfile" "$getarg"
	filecontent=$(cat "$encfile")
	read -r -p "Copy File Content? [y/N]: " tocopy
	[ "$tocopy" = "y" ] || [ "$tocopy" = "Y" ] && ( echo "$filecontent" | xclip -r -sel c )
}

[ -n "$getarg" ] && [ -f "$getarg" ] && encryptfile
[ -z "$getarg" ] && encryptmsg
