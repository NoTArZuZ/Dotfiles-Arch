#!/usr/bin/env bash

xmenu <<EOF | sh &
Launch
	Run App				dmenu_run -bw 2 -l 10 -c
	Terminal			st
	Cromite				cromite
	Legcord				legcord
	Mumble				mumble
	Steam					steam
	Conky					conky-toggle

Scripts
	hub-script					hub-script
	Screenshot 					hub-script maim-scrshot
	Color Picker				hub-script color-picker
	Set Wallpaper				hub-script set-wallpaper -s
	Random Wallpaper		hub-script set-wallpaper -r

Settings
	Exit					duskc run_command quit
	Shutdown			shutdown now
	Restart				reboot
EOF

