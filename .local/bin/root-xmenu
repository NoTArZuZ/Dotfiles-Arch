#!/usr/bin/env bash

xmenu="xmenu"
[ "$1" = "bar" ] && xmenu="xmenu -p 0x20"

$xmenu <<EOF | sh &
Launch
	Apps		hub-script run-desktop
	Dmenu		dmenu_run -bw 2 -l 10 -c
	Terminal		st
	Cromite		cromite
	Discord		discord
	Steam		steam

Scripts
	Hub		hub-script
	Games		hub-script game-launcher
	Screenshot		hub-script maim-scrshot
	Color Picker		hub-script color-picker
	Set Wallpaper		hub-script set-wallpaper -s
	Random Wallpaper		hub-script set-wallpaper -r
	Conky		conky-toggle
	Screenkey		screenkey-toggle
	Picom		picom-toggle

Power
	Exit		duskc run_command quit
	Shutdown		shutdown now
	Restart		reboot
EOF
