#!/usr/bin/env bash

set -eo pipefail

[ "$1" ] || { echo "use option sixel, view or info"; exit 1; }
[ "$1" = "view" ] && mode="$1"
[ "$1" = "sixel" ] && mode="$1"
[ "$1" = "info" ] && mode="$1"

waitmpd()
{
  [ "$1" = "init" ] && {
    while [ -z "$current" ]; do
      sleep 1
      current="$(mpc -f "%artist% - %album%" current)"
      [ "$mode" = "info" ] && current="$(mpc -f "%artist% %album% %title%" current)"
    done
    cached="$current"
  }
  [ "$1" = "loop" ] && {
    while [ "$current" = "$cached" ]; do
      sleep 1
      current="$(mpc -f "%artist% - %album%" current)"
      [ "$mode" = "info" ] && current="$(mpc -f "%artist% %album% %title%" current)"
      [ "$mode" = "view" ] && { ps -p $viewpid >/dev/null || exit 0; }
      [ -z "$current" ] && current="$cached"
    done
    cached="$current"
  }
  return 0
}

waitmpd init

[ "$mode" = "sixel" ] && {
  [ -f "/tmp/$current" ] || mpc albumart "$(mpc -f "%file%" current)" > "/tmp/$current"
  command clear; echo -e "\n"
  img2sixel -w 400 -h 400 "/tmp/$current"
  while true; do
    waitmpd loop
    [ -f "/tmp/$current" ] || mpc albumart "$(mpc -f "%file%" current)" > "/tmp/$current"
    command clear; echo -e "\n"
    img2sixel -w 400 -h 400 "/tmp/$current"
  done
}

[ "$mode" = "view" ] && {
  [ -f "/tmp/$current" ] || mpc albumart "$(mpc -f "%file%" current)" > "/tmp/$current"
  nsxiv -b -a -p "/tmp/$current" &
  viewpid="$!"
  while true; do
    waitmpd loop
    [ -f "/tmp/$current" ] || mpc albumart "$(mpc -f "%file%" current)" > "/tmp/$current"
    kill $viewpid
    nsxiv -b -a -p "/tmp/$current" &
    viewpid="$!"
  done
}

[ "$mode" = "info" ] && {
  command clear && mpc -f "TITLE: %title%\nARTIST: %artist%\nALBUM: %album%\nTIME: %time%\nTRACK: %track%\nDATE: %date%\nGENRE: %genre%\nCOMMENT: %comment%" current
  while true; do
    waitmpd loop
    command clear && mpc -f "TITLE: %title%\nARTIST: %artist%\nALBUM: %album%\nTIME: %time%\nTRACK: %track%\nDATE: %date%\nGENRE: %genre%\nCOMMENT: %comment%" current
  done
}
