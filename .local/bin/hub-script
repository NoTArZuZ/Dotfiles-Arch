#!/usr/bin/env bash

set -euo pipefail

. $HOME/Scripts/script-vars

[ -z "$*" ] || exec ${scriptdir}/${*} || exit 1

list=$(find -L $scriptdir -type f -executable | wc -l)
choose=$(find -L $scriptdir -type f -executable -printf '%f\n' | sort | $menu "Run script:" -R -1 -l $list)
exec "${scriptdir}/${choose}"
