#!/usr/bin/env bash
# Dependencies: android-tools scrcopy v4l2loopback-dkms polkit

set -eo pipefail

webcam()
{
  adb connect "${ip}:${port_connect}"
  pkexec modprobe v4l2loopback
  scrcpy --video-source=camera --camera-size=1920x1080 --camera-facing=${facing} --v4l2-sink=/dev/video0 --no-playback
  adb kill-server
  exit 0
}

screen()
{
  adb connect "${ip}:${port_connect}"
  scrcpy -m1920 --max-fps=60
  adb kill-server
  exit 0
}

audio()
{
  adb connect "${ip}:${port_connect}"
  scrcpy --no-video --no-control
  adb kill-server
  exit 0
}

pair()
{
  read -r -p "Enter Pair Port: " port_pair
  adb pair $ip:$port_pair
  return 0
}

connect()
{
  [ "$paired" ] || read -r -p "Have you paired with PC? [Y/n] " paired
  [ "$ip" ] || read -r -p "Enter Device IP: " ip
  [ "$port_connect" ] || read -r -p "Enter Connection Port: " port_connect
  [ "$paired" = "N" ] || [ "$paired" = "n" ] && pair
  return 0
}


helpmsg()
{
  echo -e "[-w|webcam] - headless webcam \
  \n[-s|screen] - control device \
  \n[-a|audio]  - listen to audio \
  \n[-r|paired] - skip pairing \
  \n[-b|back] - use back camera"
  exit 1
}

singleflag=0
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
    -r | paired)
        paired="y"
        shift
        ;;
    -b | back)
        webcam_back=true
        shift
        ;;
    -w | webcam)
        webcam_var=true
        ((singleflag += 1))
        shift
        ;;
    -s | screen)
        screen_var=true
        ((singleflag += 1))
        shift
        ;;
    -a | audio)
        audio_var=true
        ((singleflag += 1))
        shift
        ;;
    -* | --*) helpmsg ;;
    *)
        POSITIONAL_ARGS+=("$1")
        shift
        ;;
    esac
done

set -- "${POSITIONAL_ARGS[@]}"

[ $singleflag = 1 ] || helpmsg
facing="front"; [ $webcam_back ] && facing="back"

[ "$webcam_var" ] && { connect; webcam; }
[ "$screen_var" ] && { connect; screen; }
[ "$audio_var" ] && { connect; audio; }
