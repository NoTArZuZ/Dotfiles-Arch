#!/usr/bin/env bash

getarg="$@"
filefmt=$(echo "$getarg" | rev | cut -b -4 | rev)

decryptmsg() {
	tempfile="/tmp/tmpdecmsg-$(date '+%N')"
	$EDITOR "$tempfile"; [ -s "$tempfile" ] || return 1
	decmsg=$(cat "$tempfile" | gpg --decrypt)
	rm -f "$tempfile"
	echo "$decmsg"
	read -r -p "Copy/Edit/Exit [c/e/N]: " topost
	[ "$topost" = "e" ] || [ "$topost" = "E" ] && ( echo "$decmsg" | $EDITOR )
	[ "$topost" = "c" ] || [ "$topost" = "C" ] && ( echo "$decmsg" | xclip -r -sel c )
}
decryptfile() {
	[ ! -f "$getarg" ] && echo "File does not exist" && return 1
	decfile=$(echo "$getarg" | sed 's/.\{4\}$//')
	gpg --decrypt --output "$decfile" "$getarg"
	rm -i "$getarg"
	read -r -p "Open file? [Y/n]: " toopen
	[ "$toopen" = "y" ] || [ "$toopen" = "Y" ] || [ -z "$toopen" ] && ( xdg-open "$decfile" )
}

[ -n "$getarg" ] && [ -f "$getarg" ] && [ "$filefmt" = ".gpg" ] && decryptfile
[ -z "$getarg" ] && decryptmsg
