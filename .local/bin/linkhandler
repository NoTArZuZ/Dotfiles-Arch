#!/usr/bin/env bash

[ -z "$1" ] && echo "No arguments given" && exit 1

case "$1" in
  *://*.png*|*://*.jpg*|*://*.jpeg*|*://*.gif*) nsxiv-url "$1" ;;
  *://*.mp4*|*://*.mov*|*://*.mp3*|*://*.wav*|*://*.ogg*|*://*.m4a*|*://*.flac*|*://inv*.nadeko.net/watch*) mpv "$1" ;;
  *://*.*) cromite "$1" ;;
  *) echo "Don't know what to do with this url"; exit 1 ;;
esac
